# Supabase (Project Settings → API)
# Vercel: las mismas variables en Project → Settings → Environment Variables (Production + Preview).
# La clave pública es la "anon" o la "publishable" (según el dashboard).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bundle iOS local → Mobile API de OWNLEVEL. Es un origin público, no un secreto.
NEXT_PUBLIC_OWNLEVEL_API_BASE_URL=https://www.ownlevel.fit

# Exclusivamente server-side: preferir la nueva sb_secret_... para la API privada.
# No usar NEXT_PUBLIC_ ni exponerla al navegador. SERVICE_ROLE queda como fallback legacy.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
